# Copiar a .env y completar. El .env no se sube al repositorio.
# Lo leen docker compose (para crear la base) y los servicios Node.

# los tres brokers del docker-compose
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094

# base de datos de report y audit. Son los nombres estándar de PostgreSQL:
# la librería pg también los lee sin configurar nada más
PGHOST=localhost
PGPORT=5433
PGDATABASE=pedidos360
PGUSER=pedidos360
PGPASSWORD=elige-una-contrasena
