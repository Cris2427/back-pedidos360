{
  "name": "pedidos360-kafka",
  "version": "1.0.0",
  "description": "Pedidos360: eventos de pedidos en Kafka. Publicador, consumidores report y audit, DLT y servicio admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "up": "docker compose up -d --wait",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "topics": "node --env-file=.env --disable-warning=TimeoutNegativeWarning admin/setup.js",
    "db": "node --env-file=.env db/setup.js",
    "admin": "node --env-file=.env --disable-warning=TimeoutNegativeWarning admin/server.js",
    "producer": "node --env-file=.env --disable-warning=TimeoutNegativeWarning bridge/producer.js",
    "report": "node --env-file=.env --disable-warning=TimeoutNegativeWarning report/consumer.js",
    "audit": "node --env-file=.env --disable-warning=TimeoutNegativeWarning audit/consumer.js",
    "timeline": "node --env-file=.env --disable-warning=TimeoutNegativeWarning audit/timeline.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1"
  }
}